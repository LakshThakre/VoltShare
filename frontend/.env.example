# VoltShare Frontend Environment Variables
# If running Expo Go on the same network (Wi-Fi / Mobile Hotspot):
# EXPO_PUBLIC_API_URL=http://<YOUR_COMPUTER_LOCAL_IP>:4000

# If running Expo Go on a different network (using ngrok or localtunnel for backend):
# EXPO_PUBLIC_API_URL=https://your-backend-tunnel.ngrok-free.app
