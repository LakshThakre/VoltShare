# ==============================================================================
# VoltShare .gitignore
# Covers Monorepo Root, Frontend (React Native / Expo), and Backend (Node / Express)
# ==============================================================================

# 1. Dependencies
node_modules/
*/node_modules/
npm-debug.*
yarn-debug.*
yarn-error.*
pnpm-debug.log*
lerna-debug.log*

# 2. Environment Variables & Secrets (Keep .env.example tracked)
.env
.env.*
!.env.example
*/.env
*/.env.*
!*/.env.example

# 3. Expo & Metro Bundler
.expo/
*/.expo/
.expo-shared/
*/.expo-shared/
web-build/
*/web-build/
expo-env.d.ts
*/expo-env.d.ts
.metro-health-check*
metro-cache/
*/metro-cache/

# 4. Build Artifacts & Distribution Outputs
dist/
*/dist/
build/
*/build/
out/
*/out/

# 5. Native Mobile Builds (Expo Prebuild / Android & iOS)
/android/
/ios/
frontend/android/
frontend/ios/
.kotlin/
*.orig.*

# 6. Database Storage & Docker Volumes
postgres_data/
pgdata/
*.sqlite
*.sqlite3
*.db

# 7. Security, Keystores & Signing Certificates
*.jks
*.p8
*.p12
*.key
*.keystore
*.mobileprovision
*.pem
*.cer
*.crt

# 8. TypeScript & Cache
*.tsbuildinfo
.cache/
*/.cache/

# 9. Testing & Code Coverage
coverage/
*/coverage/
.nyc_output/

# 10. Logs & Temporary Files
*.log
*.log.*
*.tmp
*.bak
*~
*.swp
*.swo

# 11. Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.directory

# 12. IDEs & Code Editors
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# 13. Local Developer Quickstart Guides
Quide.md
quide.md
Guide.md
guide.md
